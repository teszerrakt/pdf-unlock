// Cloudflare Workers static assets: `npm run deploy:cloudflare`. Headers come from public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-unlock",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
